{
  "firestore": {
    "rules": "mobile/firestore.rules",
    "indexes": "mobile/firestore.indexes.json"
  },
  "database": {
    "rules": "mobile/database.rules.json"
  },
  "hosting": {
    "site": "demo-grass-local-publica",
    "public": "web/public",
    "ignore": [
      "firebase.json",
      "firebase.publica.json",
      "firebase.personal.json",
      "firebase.emuladores.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8081
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": false
  }
}
